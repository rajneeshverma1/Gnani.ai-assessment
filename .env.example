# Vyapar Voice Environment Configuration
# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyapar_voice?schema=public"

# -------------------------------------------------------------
# Gnani.ai API Keys (Prisma STT, Evon LLM, Timbre TTS)
# -------------------------------------------------------------
# Master Key fallback:
GNANI_API_KEY="your_gnani_api_key_here"

# Speech-to-Text (Prisma STT) Key:
GNANI_STT_API_KEY="your_gnani_stt_api_key_here"

# Text-to-Speech (Timbre TTS) Key:
GNANI_TTS_API_KEY="your_gnani_tts_api_key_here"

# LLM Reasoning (Evon LLM) Key:
GNANI_LLM_API_KEY="your_gnani_llm_api_key_here"

# Gnani Base URL (Default: https://api.gnani.ai):
GNANI_BASE_URL="https://api.gnani.ai"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3001"